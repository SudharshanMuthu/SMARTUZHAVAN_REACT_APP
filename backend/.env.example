# Smart Uzhavan Backend — Environment Variables Template
# Copy this file to .env and configure your environment-specific values.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Persistent Data Storage Directory (Optional)
# For cloud deployments with persistent volumes, set to the volume mount point (e.g. /app/data or /data)
# DATA_DIR=/app/data

# Security / CORS Allowed Origins (comma-separated list for multiple origins, or * for all)
CORS_ORIGIN=*

# Administrator Authentication Security
# Custom secret key used to sign and verify HMAC SHA-256 admin session tokens
ADMIN_JWT_SECRET=replace_with_a_secure_random_hex_or_string_in_production
# Optional: SHA-256 hash of a custom admin password (e.g. echo -n "MyPassword" | sha256sum)
# ADMIN_PASSWORD_HASH=

# Request Body Size Limit
REQUEST_LIMIT=10mb

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave as placeholder if not yet configured; backend safely falls back to domain agronomy mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Open Government Data (data.gov.in) Agmarknet Live API Key
# Register at https://data.gov.in to obtain an API key for live daily APMC mandi updates.
# If omitted or left as placeholder, backend serves verified daily Agmarknet bulletins.
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Firebase Admin Configuration (Server-side ONLY)
# Option 1: Direct Environment Variables (Recommended for cloud/container deployments)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Option 2: Path to downloaded Service Account JSON file (Alternative)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
