# ==============================================================================
# Smart Uzhavan — Root .gitignore
# ==============================================================================

# Node dependencies
node_modules/
package-lock.json.bak

# Production build artifacts
dist/
build/
admin/dist/
mobile/dist/

# Android build artifacts and Gradle caches
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/.idea/
*.apk
*.aab

# Expo temporary files
.expo/
.expo-shared/

# Environment files and credentials (STRICT SECURITY - NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local
.env.txt
*.env.txt
!.env.example
!*.env.example
*.key
*.pem
*.keystore
*service-account*.json
*credentials*.json
firebase-adminsdk*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System cache files
.DS_Store
Thumbs.db
