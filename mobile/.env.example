# Smart Uzhavan — Mobile Environment Variables Template
# Copy this file to `mobile/.env` and replace placeholders with your project values.
# DO NOT commit real secrets or service account keys to client repositories.

# ==============================================================================
# 1. Firebase Client Web SDK Configuration (smart-uzhavan-369b0)
# ==============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=smart-uzhavan-369b0.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=smart-uzhavan-369b0
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=smart-uzhavan-369b0.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=794508821915
EXPO_PUBLIC_FIREBASE_APP_ID=your_expo_web_app_id_here
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ==============================================================================
# 2. Backend API Base URL Configuration (Port 5000)
# ==============================================================================
# For Real Android Physical Device Testing:
# Replace <YOUR_COMPUTER_LAN_IP> with your PC's local Wi-Fi IPv4 address (e.g. from running `ipconfig`)
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.15:5000/api (or http://10.254.67.59:5000/api)
#
# For Android Studio Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
#
# For iOS Simulator / Web:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_API_URL=http://10.254.67.59:5000/api
